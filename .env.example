# SQLite local (padrão, funciona sem configurar nada):
DATABASE_URL="file:./dev.db"

# Para produção com Postgres (recomendado ao publicar - ex: Neon, Supabase, Railway):
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Gere um valor aleatório longo para isso (ex: `openssl rand -base64 32`)
AUTH_SECRET="troque-por-uma-string-aleatoria-longa"
